<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tracker.controllers.AñadirController">
   <center>
      <VBox fillWidth="false" prefWidth="450.0" spacing="7.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Label text="Título" />
                  <TextField fx:id="inpTitulo" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Empresa" />
                  <ComboBox fx:id="inpEmpresa" editable="true" prefWidth="150.0" promptText="Nombre de la empresa" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Descripción" />
                  <TextArea fx:id="inpDesc" prefHeight="68.0" prefWidth="226.0" wrapText="true" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Estado" />
                  <ChoiceBox fx:id="choiceboxEstado" prefWidth="150.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Fecha de postulación" />
                  <DatePicker fx:id="dateFechaPostulacion" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Enlace" />
                  <TextField fx:id="inpEnlace" prefHeight="26.0" prefWidth="319.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Salario" />
                  <TextField fx:id="inpSalario" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="10.0">
               <children>
                  <Label text="Notas" />
                  <TextField fx:id="inpNotas" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" prefHeight="34.0" prefWidth="430.0" spacing="50.0">
               <children>
                  <Button fx:id="btnAñadir" mnemonicParsing="false" onAction="#onClickAñadir" text="Añadir" />
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onClickCancelar" text="Cancelar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
