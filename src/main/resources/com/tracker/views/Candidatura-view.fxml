<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tracker.controllers.DetallesController">
   <center>
      <VBox alignment="CENTER" fillWidth="false" spacing="6.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="ID:" />
                  <Label fx:id="txtID" text="Label" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Título:" />
                  <Label fx:id="txtTitulo" text="Label" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Empresa:" />
                  <Label fx:id="txtEmpresa" text="Label" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Estado:" />
                  <RadioButton fx:id="radPendiennte" mnemonicParsing="false" onAction="#onPendiente" text="Pendiente" />
                  <RadioButton fx:id="radEntrevista" mnemonicParsing="false" onAction="#onEntrevista" text="Entrevista" />
                  <RadioButton fx:id="radAceptada" mnemonicParsing="false" onAction="#onAceptada" text="Aceptada" />
                  <RadioButton fx:id="radRechazada" mnemonicParsing="false" onAction="#onRechazada" text="Rechazada" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Fecha de postulación:" />
                  <Label fx:id="txtFechaPostulacion" text="Label" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Salario:" />
                  <Label fx:id="txtSalario" text="Label" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Notas:" />
                  <Label fx:id="txtNotas" text="Label" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" spacing="5.0">
               <children>
                  <Label text="Descripción:" />
                  <Label fx:id="txtDescripcion" alignment="TOP_LEFT" prefHeight="55.0" prefWidth="263.0" text="Label" />
               </children>
            </HBox>
            <VBox>
               <children>
                  <Label text="Entrevistas" />
                  <ListView fx:id="listEntrevistas" prefHeight="79.0" prefWidth="537.0" />
               </children>
            </VBox>
            <HBox alignment="CENTER" fillHeight="false" prefHeight="30.0" prefWidth="369.0" spacing="50.0">
               <children>
                  <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#onClickModificar" text="Modificar" />
                  <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onClickVolver" text="Volver" />
                  <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onClickEliminar" text="Eliminar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="13.0" right="13.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
