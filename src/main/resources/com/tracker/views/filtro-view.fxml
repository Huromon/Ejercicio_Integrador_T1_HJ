<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefWidth="544.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tracker.controllers.FiltroController">
   <center>
      <VBox prefWidth="544.0" spacing="7.0">
         <children>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Label text="Título" />
                  <TextField fx:id="textfieldTitulo" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Label text="Empresa" />
                  <TextField fx:id="textfieldEmpresa" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Label text="Estado" />
                  <ChoiceBox fx:id="choiceboxEstado" prefWidth="150.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Label text="Fecha de postulación" />
                  <DatePicker fx:id="dateFechaMin" />
                  <DatePicker fx:id="dateFechaMax" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Label text="Salario" />
                  <TextField fx:id="inpSalarioMin" />
                  <TextField fx:id="inpSalarioMax" />
               </children>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false" spacing="20.0">
               <children>
                  <Button fx:id="btnFiltrar" mnemonicParsing="false" onAction="#onClickFiltrar" text="Filtrar" />
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onClickCancelar" text="Cancelar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
